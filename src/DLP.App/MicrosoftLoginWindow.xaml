<Window x:Class="DLP.App.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="微软账号登录" Width="520" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Surface}" FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="20,16,20,8">
            <TextBlock Text="微软账号登录" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource SmallText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="20,0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
            <wv2:WebView2 x:Name="Web" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,14">
            <Button Content="重新加载" Style="{StaticResource SecondaryButton}" Click="Reload_Click" />
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
