<Window x:Class="DLP.App.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微软账号登录" Width="480" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Surface}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="微软账号登录" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="点「添加微软账号」后会自动打开浏览器；验证码已复制，粘贴到网页即可。" Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <StackPanel Visibility="{Binding NeedsClientId, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="需要先注册一次微软客户端（所有用户共用，只需你注册一次）：" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource SmallText}" Margin="0,8,0,0" TextWrapping="Wrap">
                    1. 打开 portal.azure.com → Microsoft Entra ID → 应用注册 → 新注册<LineBreak />
                    2. 账户类型选「个人 Microsoft 帐户」，重定向 URI 选「公共客户端/本机」<LineBreak />
                    3. 创建后复制「应用程序(客户端) ID」，粘贴到下面<LineBreak />
                    4. 到「身份验证」里把「允许公共客户端流」打开
                </TextBlock>
                <TextBox Text="{Binding ClientIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"
                         Height="34" VerticalContentAlignment="Center" Padding="8,0" FontFamily="Consolas" />
            </StackPanel>

            <TextBlock Text="{Binding Code}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock Text="{Binding VerificationUri}" Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,16,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存并登录" Style="{StaticResource PrimaryButton}" Click="SaveClientId_Click"
                    Visibility="{Binding NeedsClientId, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="去设置填写" Style="{StaticResource SecondaryButton}" Click="OpenSettings_Click"
                    Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="重新打开登录页" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenBrowser_Click"
                    IsEnabled="{Binding HasVerificationUri}" />
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
