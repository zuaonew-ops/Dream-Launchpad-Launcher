<Window x:Class="DLP.App.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微软账号登录" Width="460" Height="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Surface}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="微软账号登录" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="点「添加微软账号」后会自动打开浏览器；验证码已复制，粘贴到网页即可。" Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Code}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding VerificationUri}" Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,16,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="去设置填写" Style="{StaticResource SecondaryButton}" Click="OpenSettings_Click"
                    Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="重新打开登录页" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenBrowser_Click"
                    IsEnabled="{Binding HasVerificationUri}" />
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
