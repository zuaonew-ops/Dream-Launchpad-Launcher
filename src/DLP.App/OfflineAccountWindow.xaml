<Window x:Class="DLP.App.OfflineAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加离线账号" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">
    <StackPanel Margin="20">
        <TextBlock Text="离线用户名" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Style="{StaticResource TextBoxStyle}" Margin="0,6,0,0" MaxLength="16" />
        <TextBlock Text="离线账号只能玩单人和局域网，不能进入正版服务器；可以添加多个来回切换。"
                   Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" IsCancel="True" />
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
