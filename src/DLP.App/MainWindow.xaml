<Window x:Class="DLP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Dream Launchpad Launcher"
        Width="1160" Height="760" MinWidth="980" MinHeight="640"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{StaticResource PanelBrush}">
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource AccentBrush}" />
                <TextBlock Text="Dream Launchpad" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource GhostButton}" Click="Minimize_Click" Width="46" Height="46" Padding="0"
                        Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                <Button Style="{StaticResource GhostButton}" Click="Maximize_Click" Width="46" Height="46" Padding="0"
                        Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                <Button Style="{StaticResource GhostButton}" Click="Close_Click" Width="46" Height="46" Padding="0"
                        Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="本地启动器" Margin="22,22,0,10" FontSize="11" Foreground="{StaticResource MutedBrush}" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                             Style="{StaticResource NavListStyle}" VerticalAlignment="Top">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Margin="16,0,16,16" Padding="12" Background="{StaticResource CardBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="离线账号" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding AccountName}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
