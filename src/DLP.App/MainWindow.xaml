<Window x:Class="DLP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dream Launchpad Launcher"
        Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">
    <Grid AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="18,18,18,10">
                    <TextBlock Text="Dream Launchpad" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Minecraft 启动器" Style="{StaticResource SmallText}" Margin="0,3,0,0" />
                </StackPanel>

                <ListBox Grid.Row="1" Margin="8,4,8,8" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Line}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <Button x:Name="AccountButton" Click="Account_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" Padding="14,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Line}">
                                            <TextBlock Text="{Binding AccountInitial}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AccountName}" FontSize="12" />
                                            <TextBlock Text="{Binding AccountKind}" Style="{StaticResource SmallText}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Line}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountButton}" Placement="Top"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="8">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="8" Width="230">
                        <StackPanel>
                            <TextBlock Text="切换账号" Style="{StaticResource SmallText}" Margin="8,4,8,6" />
                            <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding CurrentAccount}"
                                     Background="Transparent" BorderThickness="0" MaxHeight="200"
                                     SelectionChanged="AccountList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="8,6" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource SmallText}" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                    Width="24" Height="24" Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Foreground="{DynamicResource TextTertiary}"
                                                    ToolTip="删除这个账号" Click="RemoveAccount_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Height="1" Background="{DynamicResource Line}" Margin="6,6" />
                            <Button Content="添加离线账号" Style="{StaticResource SecondaryButton}" Click="AddOffline_Click" />
                            <Button Content="添加微软账号" Style="{StaticResource SecondaryButton}" Margin="0,6,0,0" Click="AddMicrosoft_Click" />
                            <TextBlock Text="可以添加多个离线账号，点一下就能切换" Style="{StaticResource SmallText}" Margin="4,8,4,2" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />

        <Border x:Name="TaskPopup" Grid.Column="1" Width="330" Margin="0,0,18,18"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                CornerRadius="10" Visibility="Collapsed" Opacity="0" IsHitTestVisible="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="TaskPopupOffset" Y="28" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.14" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <Grid Margin="14,10,8,4">
                    <TextBlock Text="下载任务" FontSize="12.5" FontWeight="SemiBold" />
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            HorizontalAlignment="Right" Width="24" Height="24" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextTertiary}"
                            Click="TaskPopupClose_Click" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Downloads.Tasks}" Margin="14,0,14,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <Grid>
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Speed}" Style="{StaticResource SmallText}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Stage}" Style="{StaticResource SmallText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallText}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Style="{StaticResource ProgressBarStyle}" Height="5" Margin="0,4,0,0"
                                             Value="{Binding Percent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </Grid>
</Window>
