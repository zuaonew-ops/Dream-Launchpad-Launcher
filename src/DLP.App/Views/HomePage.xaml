<UserControl x:Class="DLP.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="开始游戏" Style="{StaticResource H2}" />

                        <Grid Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="18" Background="#E4E6E8">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="离线模式" Style="{StaticResource SmallText}" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="离线账号" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="启动版本" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                        <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding InstalledVersions}"
                                  SelectedItem="{Binding SelectedVersion}" />

                        <TextBlock Text="内存上限" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <Grid>
                            <Slider Style="{StaticResource SliderStyle}" Minimum="512" Maximum="8192"
                                    TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MemoryMb}" />
                            <TextBlock Text="{Binding MemoryMb, StringFormat={}{0} MB}" HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,-2,0,0" FontSize="11.5"
                                       Foreground="{StaticResource TextTertiary}" />
                        </Grid>

                        <Button Content="启动游戏" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,22,0,0"
                                FontSize="14" Command="{Binding LaunchCommand}" AutomationProperties.Name="启动游戏" />

                        <TextBlock Text="{Binding Status}" Style="{StaticResource SmallText}" Margin="0,12,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="未安装任何版本，请先到「版本」页安装。" Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource Danger}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasNoVersions, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="使用提示" Style="{StaticResource H2}" />
                        <TextBlock Text="· 离线账号只能进入离线游戏与本地世界，不能连接正版服务器。" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock Text="· 启动参数与游戏输出会实时写入「日志」页。" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="· 实例之间 mods、存档、配置完全隔离。" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="实例" Style="{StaticResource H2}" />
                        <ComboBox Style="{StaticResource ComboBoxStyle}" Margin="0,14,0,0"
                                  ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" />
                        <Button Content="打开实例目录" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                                Command="{Binding OpenFolderCommand}" />
                        <TextBlock Text="每个实例拥有独立的 mods、存档与配置。" Style="{StaticResource SmallText}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="数据目录" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding DataRoot}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="统计" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding InstalledVersionCount, StringFormat=已安装版本：{0} 个}" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding InstanceCount, StringFormat=实例数量：{0} 个}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
