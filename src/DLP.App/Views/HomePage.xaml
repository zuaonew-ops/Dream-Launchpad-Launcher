<UserControl x:Class="DLP.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageRootStyle}" Margin="40,16,40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <!-- 左侧欢迎区 -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="MINECRAFT · JAVA EDITION" Style="{StaticResource Eyebrow}" />
                    <TextBlock Margin="0,14,0,0" FontSize="40" FontWeight="SemiBold" Foreground="White"
                               TextWrapping="Wrap" LineHeight="54">
                        <Run Text="{Binding Username, Mode=OneWay}" /><Run Text="，准备好出发了吗？" />
                    </TextBlock>
                    <TextBlock Margin="0,14,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="选择实例与版本，一键进入方块世界。所有资源都会自动校验与补齐。" />

                    <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                        <Border Style="{StaticResource Chip}" Padding="16,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedVersion, TargetNullValue=未选择版本}" Margin="9,0,0,0"
                                           FontSize="14" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="16,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedInstance, TargetNullValue=default}" Margin="9,0,0,0"
                                           FontSize="14" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                        <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="启动游戏"
                                Command="{Binding LaunchCommand}" Padding="34,17">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="启动游戏" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlassButton}" Margin="12,0,0,0"
                                Command="{Binding OpenFolderCommand}" Content="打开实例目录" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="2,22,0,0">
                        <Ellipse Width="7" Height="7" Fill="#6EE7B7" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Status}" Margin="9,0,0,0" FontSize="12.5"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Margin="2,10,0,0" FontSize="12.5" Foreground="#FCA5A5" TextWrapping="Wrap"
                               Visibility="{Binding HasNoVersions, Converter={StaticResource BoolToVisibility}}"
                               Text="还没有安装任何版本，请到「版本」页安装一个再启动。" />
                </StackPanel>

                <!-- 右侧配置卡 -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" VerticalAlignment="Center">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="启动配置" Style="{StaticResource H2}" FontSize="19" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Width="32" Height="32" AutomationProperties.Name="刷新"
                                    HorizontalAlignment="Right" Command="{Binding RefreshCommand}" ToolTip="刷新" />
                        </Grid>

                        <TextBlock Text="实例" Style="{StaticResource FieldLabel}" Margin="0,22,0,7" />
                        <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding Instances}"
                                  SelectedItem="{Binding SelectedInstance}" />

                        <TextBlock Text="版本" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" />
                        <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding InstalledVersions}"
                                  SelectedItem="{Binding SelectedVersion}" />

                        <TextBlock Text="离线用户名" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" />
                        <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,18,0,0">
                            <TextBlock Text="内存上限" Style="{StaticResource FieldLabel}" />
                            <TextBlock HorizontalAlignment="Right" Margin="0,0,0,7" FontSize="12" Foreground="White">
                                <Run Text="{Binding MemoryMb, Mode=OneWay}" /><Run Text=" MB" />
                            </TextBlock>
                        </Grid>
                        <Slider Style="{StaticResource SliderStyle}" Minimum="512" Maximum="8192"
                                TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MemoryMb}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 底部统计 -->
            <Grid Grid.Row="1" Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GlassCard}" Padding="20,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding InstalledVersionCount}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="个已安装版本" Margin="10,0,0,4" FontSize="12" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="20,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding InstanceCount}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="个实例" Margin="10,0,0,4" FontSize="12" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource GlassCard}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="数据目录" FontSize="11" Foreground="{StaticResource FaintBrush}" />
                        <TextBlock Text="{Binding DataRoot}" Margin="0,6,0,0" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>