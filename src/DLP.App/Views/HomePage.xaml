<UserControl x:Class="DLP.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="开始游戏" Style="{StaticResource H2}" />

                        <Grid Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="18" Background="#E4E6E8">
                                    <TextBlock Text="{Binding AccountInitial, FallbackValue=?}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountName}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AccountKind}" Style="{StaticResource SmallText}" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="左下角切换账号" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="启动版本" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                        <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding InstalledVersions}"
                                  SelectedItem="{Binding SelectedVersion}" />

                        <TextBlock Text="内存上限" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <Grid>
                            <Slider Style="{StaticResource SliderStyle}" Minimum="512" Maximum="{Binding MaxMemoryMb}"
                                    SmallChange="128" LargeChange="1024" Value="{Binding MemoryMb}" />
                            <TextBlock Text="{Binding MemoryMb, StringFormat={}{0} MB}" HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,-2,0,0" FontSize="11.5"
                                       Foreground="{StaticResource TextTertiary}" />
                        </Grid>

                        <Button Content="启动游戏" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,22,0,0"
                                FontSize="14" Command="{Binding LaunchCommand}" AutomationProperties.Name="启动游戏" />

                        <TextBlock Text="{Binding Status}" Style="{StaticResource SmallText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="还没有安装版本，去「下载」页安装一个。" Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource Danger}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasNoVersions, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="使用提示" Style="{StaticResource H2}" />
                        <TextBlock Text="· 离线账号只能进入离线游戏与本地世界，不能连接正版服务器。" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock Text="· 微软账号在左下角切换账号里登录，登录后可进入正版服务器。" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="· 每个版本都有独立的 game 目录，mods、存档、配置互不影响。" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="版本隔离目录" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding GameDir}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <Button Content="打开游戏目录" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                                Command="{Binding OpenFolderCommand}" />
                        <TextBlock Text="mods、资源包、光影、存档都放在这里。" Style="{StaticResource SmallText}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="数据目录" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding DataRoot}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="全部数据都在启动器所在文件夹内。" Style="{StaticResource SmallText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="统计" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding InstalledVersionCount, StringFormat=已安装版本：{0} 个}" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
