<UserControl x:Class="DLP.App.Views.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="8">
            <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="0,1" Padding="12,9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F4F5F6" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="13" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="180">
                        <TextBlock Text="游戏版本" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding ManifestVersions}"
                                  SelectedItem="{Binding SelectedGameVersion}" IsEditable="False" IsSynchronizedWithCurrentItem="False" />
                    </StackPanel>
                    <StackPanel Width="130" Margin="12,0,0,0" Visibility="{Binding ShowLoader, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="模组加载器" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding LoaderNames}"
                                  SelectedItem="{Binding SelectedLoader}" />
                    </StackPanel>
                    <StackPanel Width="190" Margin="12,0,0,0" Visibility="{Binding ShowLoader, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="加载器版本" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding LoaderVersions}"
                                  SelectedItem="{Binding SelectedLoaderVersion}" DisplayMemberPath="DisplayName" />
                    </StackPanel>
                    <Button Content="安装" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="16,0,0,0"
                            Command="{Binding InstallVersionCommand}" Visibility="{Binding IsVersionTab, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="选择版本后点安装；装完可在「游戏版本」里管理" Style="{StaticResource SmallText}"
                               VerticalAlignment="Bottom" Margin="14,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding IsVersionTab, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="搜索" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,0,0,0"
                        Command="{Binding SearchCommand}" Visibility="{Binding IsContentTab, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0,12,0,0">
                <Grid>
                    <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding ManifestVersions}"
                             SelectedItem="{Binding SelectedGameVersion}"
                             Visibility="{Binding IsVersionTab, Converter={StaticResource BoolToVisibility}}"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5" Margin="6,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedProject}"
                             Visibility="{Binding IsContentTab, Converter={StaticResource BoolToVisibility}}"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="0,1" Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F4F5F6" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SmallText}" TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                    <TextBlock Style="{StaticResource SmallText}" Margin="0,3,0,0">
                                        <Run Text="{Binding Author, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Downloads, Mode=OneWay}" /><Run Text=" 次下载" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,12,0" />
                        <Button HorizontalAlignment="Right" Content="下载到版本目录" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallContentCommand}"
                                Visibility="{Binding IsContentTab, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ProgressBarStyle}" Margin="0,10,0,0" Value="{Binding Progress}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
