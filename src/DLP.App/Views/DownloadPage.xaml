<UserControl x:Class="DLP.App.Views.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="8">
            <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="0,1" Padding="12,9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F4F5F6" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="13" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 二级菜单 -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding HasSubTabs, Converter={StaticResource BoolToVisibility}}">
                <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding SubTabs}"
                         SelectedItem="{Binding SelectedSubTab}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="14,6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F1F2F4" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12.5" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding SubTabHint}" Style="{StaticResource SmallText}" VerticalAlignment="Center"
                           Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="420" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="180">
                        <TextBlock Text="游戏版本" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding ManifestVersions}"
                                  SelectedItem="{Binding SelectedGameVersion}" IsEditable="False" IsSynchronizedWithCurrentItem="False" />
                    </StackPanel>
                    <StackPanel Width="130" Margin="12,0,0,0" Visibility="{Binding ShowLoader, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="模组加载器" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding AvailableLoaders}"
                                  SelectedItem="{Binding SelectedLoader}" />
                    </StackPanel>
                    <StackPanel Width="190" Margin="12,0,0,0" Visibility="{Binding ShowLoader, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="加载器版本" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding LoaderVersions}"
                                  SelectedItem="{Binding SelectedLoaderVersion}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="安装" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="16,0,0,0"
                            Command="{Binding InstallVersionCommand}" Visibility="{Binding IsVersionTab, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="加载器选「原版」就只装原版；选了加载器会连原版一起装好，版本列表里只显示带加载器的那个"
                               Style="{StaticResource SmallText}" VerticalAlignment="Bottom" Margin="14,0,0,8"
                               TextWrapping="Wrap" MaxWidth="260"
                               Visibility="{Binding IsVersionTab, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="搜索" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                        Command="{Binding SearchCommand}"
                        Visibility="{Binding ShowSearchButton, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="输入版本号可实时过滤列表" Style="{StaticResource SmallText}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,4,0"
                           Visibility="{Binding IsVersionTab, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10" Margin="0,12,0,0">
                <Grid>
                    <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding FilteredVersions}"
                             SelectedItem="{Binding SelectedGameVersion}"
                             Visibility="{Binding IsVersionTab, Converter={StaticResource BoolToVisibility}}"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5" Margin="6,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedProject}"
                             Visibility="{Binding IsContentTab, Converter={StaticResource BoolToVisibility}}"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="0,1" Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F4F5F6" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="6" Background="#F1F2F4" ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="?" Style="{StaticResource SmallText}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}" />
                                            <Image Source="{Binding Icon, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SmallText}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        <TextBlock Style="{StaticResource SmallText}" Margin="0,3,0,0">
                                            <Run Text="{Binding Author, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DownloadsText, Mode=OneWay}" /><Run Text=" 次下载" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsContentTab, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="8" ClipToBounds="True" Height="150" Background="#F1F2F4" Margin="0,0,0,10"
                                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding SelectedBanner, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10"
                                      Visibility="{Binding HasGallery, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Gallery}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="150" Height="86" CornerRadius="6" ClipToBounds="True" Background="#F1F2F4"
                                                Margin="0,0,8,0">
                                            <Image Source="{Binding}" Stretch="UniformToFill" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,12,0" />
                        <Button HorizontalAlignment="Right" Content="{Binding InstallActionText}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallContentCommand}"
                                Visibility="{Binding IsContentTab, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ProgressBarStyle}" Margin="0,10,0,0" Value="{Binding Progress}" />

                    <!-- 详细下载过程 -->
                    <StackPanel DataContext="{Binding Downloads.Current}"
                                Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding PercentLabel}" Style="{StaticResource SmallText}" />
                                <TextBlock Text="{Binding Speed}" Style="{StaticResource SmallText}" Margin="10,0,0,0" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallText}" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Style="{StaticResource ProgressBarStyle}" Margin="0,6,0,0" Value="{Binding Percent, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" />
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0" MaxHeight="90">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="{Binding SubTabHint}" Style="{StaticResource SmallText}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ShowLocalHint, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
