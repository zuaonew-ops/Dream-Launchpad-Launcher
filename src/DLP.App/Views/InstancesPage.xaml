<UserControl x:Class="DLP.App.Views.InstancesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,28,34,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="实例" Style="{StaticResource PageTitle}" />
                <TextBlock Text="每个实例拥有独立的 mods、存档与配置" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="刷新"
                    Style="{StaticResource BaseButton}" Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="14">
                <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Instances}"
                         SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}" Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="新建实例" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="创建" Style="{StaticResource AccentButton}" Command="{Binding CreateCommand}" />
                            <Button Content="打开目录" Style="{StaticResource BaseButton}" Margin="10,0,0,0"
                                    Command="{Binding OpenCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Margin="0,12,0,0" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="数据目录" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DataRoot}" Margin="0,8,0,0" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>