<UserControl x:Class="DLP.App.Views.InstancesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageRootStyle}" Margin="40,16,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="实例" Style="{StaticResource H1}" />
                <TextBlock Text="每个实例拥有独立的 mods、存档与配置" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GlassButton}"
                    Content="刷新" Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassCard}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Instances}"
                             SelectedItem="{Binding Selected}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Width="218" Height="128" CornerRadius="16"
                                                    Background="#16FFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" Padding="16">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#A855F7" />
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentGradientSoft}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding}" Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="独立存档目录" Margin="0,4,0,0" FontSize="11"
                                               Foreground="{StaticResource FaintBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="新建实例" Style="{StaticResource H2}" FontSize="19" />
                        <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Margin="0,20,0,7" />
                        <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="创建实例" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" />
                            <Button Content="打开目录" Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                    Command="{Binding OpenCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Margin="0,14,0,0" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="数据目录" FontSize="12" Foreground="{StaticResource FaintBrush}" />
                        <TextBlock Text="{Binding DataRoot}" Margin="0,7,0,0" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
