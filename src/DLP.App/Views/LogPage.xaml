<UserControl x:Class="DLP.App.Views.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,28,34,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="日志" Style="{StaticResource PageTitle}" />
                <TextBlock Text="启动器与游戏输出实时日志" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="清空"
                    Style="{StaticResource BaseButton}" Command="{Binding ClearCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8" Margin="0,20,0,0">
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding Lines}" VirtualizingPanel.IsVirtualizing="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
