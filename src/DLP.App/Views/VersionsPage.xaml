<UserControl x:Class="DLP.App.Views.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="游戏版本" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
                    Content="刷新" Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="10">
                <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding InstalledVersions}"
                         SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="0,1" Padding="10,9">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMuted}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Style="{StaticResource Chip}">
                                    <TextBlock Text="已安装" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="版本信息" Style="{StaticResource SmallText}" />
                    <TextBlock Text="{Binding Selected, TargetNullValue=未选择版本}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />

                    <TextBlock Text="版本目录" Style="{StaticResource FieldLabel}" Margin="0,20,0,4" />
                    <TextBlock Text="{Binding VersionDir}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />

                    <TextBlock Text="隔离游戏目录（mods / saves / 配置）" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                    <TextBlock Text="{Binding GameDir}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="打开版本目录" Style="{StaticResource SecondaryButton}" Command="{Binding OpenVersionFolderCommand}" />
                        <Button Content="打开游戏目录" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding OpenGameFolderCommand}" />
                        <Button Content="删除版本" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding DeleteCommand}" />
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="6" Padding="14" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="版本隔离" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="每个版本都使用独立的 game 目录，mods、存档、配置互不影响；启动器数据全部保存在 exe 所在文件夹。"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
