<UserControl x:Class="DLP.App.Views.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="VersionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A33" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F2A4E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,28,34,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="版本" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Tag="搜索版本" />
                    <ComboBox Grid.Row="1" Style="{StaticResource ComboBoxStyle}" Margin="0,10,0,0"
                              ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter}" />
                    <ListBox Grid.Row="2" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                             ItemContainerStyle="{StaticResource VersionItemStyle}"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Id}" FontSize="13" />
                                    <TextBlock Grid.Column="1" Text="{Binding ReleaseTime, StringFormat=yyyy-MM-dd}"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTitle}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedMeta}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="安装此版本" Style="{StaticResource AccentButton}" Command="{Binding InstallCommand}" />
                        <TextBlock Text="已安装" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <ProgressBar Style="{StaticResource ProgressBarStyle}" Value="{Binding Progress}" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding Status}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="3" Background="{StaticResource InputBrush}" CornerRadius="10" Padding="16"
                            VerticalAlignment="Bottom" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="关于安装" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="安装会下载客户端、全部依赖库、资源文件与你所需版本的 Java 运行时。所有文件都会做 SHA1 校验，重复安装只会补齐缺失文件。" />
                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="安装完成后回到「首页」即可选择该版本启动。" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
