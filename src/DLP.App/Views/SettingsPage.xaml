<UserControl x:Class="DLP.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,28,34,34">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
            <TextBlock Text="全局默认值，可在启动前临时调整" Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource CardStyle}" Margin="0,22,0,0">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="默认内存上限：" /><Run Text="{Binding MemoryMb, Mode=OneWay}" /><Run Text=" MB" />
                        </TextBlock>
                        <Slider Minimum="512" Maximum="8192" TickFrequency="512" IsSnapToTickEnabled="True"
                                Value="{Binding MemoryMb}" Width="420" HorizontalAlignment="Left" />
                    </StackPanel>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="默认离线用户名" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="下载源" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding Sources}"
                                      SelectedItem="{Binding DownloadSource}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Java 路径（留空自动检测）" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="浏览…" Style="{StaticResource BaseButton}"
                                Command="{Binding BrowseJavaCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="保存设置" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" />
                        <TextBlock Text="{Binding Status}" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding DataRoot}" Margin="0,16,0,0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="已检测到的 Java" FontSize="15" FontWeight="SemiBold" />
                        <Button HorizontalAlignment="Right" Content="重新扫描" Style="{StaticResource BaseButton}"
                                Command="{Binding ScanJavaCommand}" />
                    </Grid>
                    <ListBox Margin="0,12,0,0" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding DetectedJava}" MaxHeight="200">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,3" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
