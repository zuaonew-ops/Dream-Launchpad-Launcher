<UserControl x:Class="DLP.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="设置" Style="{StaticResource H1}" />
            <TextBlock Text="全局默认值，可在启动前临时调整" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="通用" Style="{StaticResource H2}" />

                            <TextBlock Text="默认内存上限" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                            <Grid>
                                <Slider Style="{StaticResource SliderStyle}" Minimum="512" Maximum="{Binding MaxMemoryMb}"
                                        SmallChange="128" LargeChange="1024" Value="{Binding MemoryMb}" />
                                <TextBlock Text="{Binding MemoryMb, StringFormat={}{0} MB}" HorizontalAlignment="Right"
                                           FontSize="11.5" Foreground="{StaticResource TextTertiary}" />
                            </Grid>

                            <TextBlock Text="默认离线用户名" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="下载源" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <ComboBox Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding Sources}"
                                      SelectedItem="{Binding DownloadSource}" />

                            <TextBlock Text="微软客户端 ID（注册一次，所有用户共用）" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Azure CLI 这类微软第一方应用不能申请 Xbox Live 权限，所以必须用自己注册的公共客户端：portal.azure.com → 应用注册 → 账户类型选「个人 Microsoft 帐户」→ 身份验证里打开「允许公共客户端流」→ 复制应用程序(客户端) ID 填到这里。"
                                       Style="{StaticResource SmallText}" Margin="0,6,0,0" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource SmallText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Java 运行时" Style="{StaticResource H2}" />
                            <TextBlock Text="留空则自动检测；找不到时会下载 Mojang 运行时" Style="{StaticResource SmallText}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="Java 路径" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseJavaCommand}" />
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <TextBlock Text="已检测到的 Java" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Content="重新扫描" Style="{StaticResource SecondaryButton}"
                                        Padding="12,6" Command="{Binding ScanJavaCommand}" />
                            </Grid>
                            <ListBox Margin="0,8,0,0" Background="Transparent" BorderThickness="0" MaxHeight="150"
                                     ItemsSource="{Binding DetectedJava}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource SmallText}" Margin="0,3" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="数据目录" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding DataRoot}" Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="启动器只管理自己所在文件夹里的内容。" Style="{StaticResource SmallText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
