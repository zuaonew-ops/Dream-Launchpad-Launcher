<Window x:Class="DLP.App.ModpackDropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装整合包" Width="460" Height="220"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Surface}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="安装整合包" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding FileName}" Style="{StaticResource BodyText}" Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <ProgressBar Style="{StaticResource ProgressBarStyle}" IsIndeterminate="True" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource SmallText}" Margin="0,12,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Click="Close_Click"
                    IsEnabled="{Binding CanClose}" />
        </StackPanel>
    </Grid>
</Window>
