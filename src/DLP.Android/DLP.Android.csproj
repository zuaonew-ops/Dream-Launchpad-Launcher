<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.zuao.dreamlaunchpad</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>bata0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AssemblyName>DLP.Android</AssemblyName>
    <RootNamespace>DLP.Android</RootNamespace>
    <!-- 本机用 dotnet build -t:InstallAndroidDependencies 装的 SDK/JDK，存在时直接使用 -->
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('D:\AndroidSdk')">D:\AndroidSdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('D:\AndroidJdk')">D:\AndroidJdk</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DLP.Avalonia\DLP.Avalonia.csproj" />
  </ItemGroup>
</Project>
