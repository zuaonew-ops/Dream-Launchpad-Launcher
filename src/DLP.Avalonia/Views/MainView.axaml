<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DLP.Avalonia.ViewModels"
             x:Class="DLP.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid>
        <!-- 宽屏：左侧导航 -->
        <Grid ColumnDefinitions="200,*" IsVisible="{Binding IsWide}">
            <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,14">
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,6,18" Spacing="2">
                        <TextBlock Text="Dream Launchpad" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Minecraft 启动器" Classes="tertiary" FontSize="11" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Spacing="4">
                        <TextBlock Text="{Binding AccountName}" Classes="secondary" FontSize="12" Margin="8,0" />
                        <TextBlock Text="bata0.1.0 · Avalonia" Classes="tertiary" FontSize="11" Margin="8,0,8,4" />
                    </StackPanel>

                    <ListBox Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Height="52" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
                    <TextBlock Text="{Binding CurrentTitle}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                </Border>
                <ContentControl Content="{Binding CurrentPage}" />
            </DockPanel>
        </Grid>

        <!-- 窄屏（手机）：顶部标题 + 内容 + 底部图标导航 -->
        <DockPanel IsVisible="{Binding IsCompact}">
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding CurrentTitle}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AccountName}" Classes="tertiary" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="bata0.1.0" Classes="tertiary" FontSize="11" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,6">
                <ListBox Background="Transparent" BorderThickness="0" Classes="bottombar"
                         ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <Path Data="{Binding Icon}" Fill="{DynamicResource TextTertiary}"
                                      Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" />
        </DockPanel>
    </Grid>
</UserControl>
