<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DLP.Avalonia.ViewModels"
             x:Class="DLP.Avalonia.Views.VersionsPage"
             x:DataType="vm:VersionsViewModel">

    <Grid Margin="24" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="4">
                <TextBlock Text="游戏版本" Classes="title" />
                <TextBlock Text="{Binding Status}" Classes="secondary" FontSize="12" />
            </StackPanel>
            <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="320,16,*">
            <Border Grid.Column="0" Classes="card" Padding="10">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{Binding InstalledCount, StringFormat='已安装 {0} 个版本'}"
                               Classes="tertiary" FontSize="11" Margin="8,4,8,10" />
                    <ListBox Grid.Row="1" x:Name="VersionList" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VersionItem">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Id}" FontSize="13" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{DynamicResource AccentSoft}"
                                            CornerRadius="6" Padding="8,2">
                                        <TextBlock Text="已安装" FontSize="10.5" Foreground="{DynamicResource Accent}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="还没有安装版本，去「下载」页安装" Classes="tertiary"
                               FontSize="12" TextWrapping="Wrap" Margin="8,6" VerticalAlignment="Top"
                               IsVisible="{Binding HasNoVersions}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="card" Padding="24">
                <StackPanel>
                    <TextBlock Text="版本信息" Classes="tertiary" FontSize="11" />
                    <TextBlock Text="{Binding VersionTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />

                    <TextBlock Text="版本目录" Classes="tertiary" FontSize="11" Margin="0,20,0,4" />
                    <TextBlock Text="{Binding VersionDir}" Classes="secondary" TextWrapping="Wrap" />

                    <TextBlock Text="隔离游戏目录（mods / saves / 配置）" Classes="tertiary" FontSize="11" Margin="0,12,0,4" />
                    <TextBlock Text="{Binding GameDir}" Classes="secondary" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,22,0,0">
                        <Button Classes="primary" Content="启动游戏" MinWidth="130"
                                Command="{Binding LaunchCommand}" />
                        <Button Content="打开版本目录" Command="{Binding OpenVersionFolderCommand}" />
                        <Button Content="打开游戏目录" Command="{Binding OpenGameFolderCommand}" />
                        <Button Content="删除版本" Foreground="{DynamicResource Danger}"
                                Command="{Binding RequestDeleteCommand}" />
                    </StackPanel>

                    <Border IsVisible="{Binding IsConfirmingDelete}" Background="{DynamicResource SurfaceAlt}"
                            CornerRadius="6" Padding="14" Margin="0,16,0,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="删除确认" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ConfirmMessage}" Classes="secondary" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary" Content="确认删除" Command="{Binding ConfirmDeleteCommand}" />
                                <Button Content="取消" Command="{Binding CancelDeleteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="6" Padding="14" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="版本隔离" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="每个版本都使用独立的 game 目录，mods、存档、配置互不影响；启动器数据全部保存在 exe 所在文件夹。"
                                       Classes="secondary" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
