{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dream Launchpad Launcher",
  "version": "0.29.0",
  "identifier": "cn.gtsn.dlp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dream Launchpad Launcher",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
